# Copy to Railway → Variables (or local backend/.env)
# Neon: use pooled URL for runtime; direct URL optional for migrate-only jobs.

NODE_ENV=production
PORT=3000

# Neon PostgreSQL (Settings → Connection string → Pooled)
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=1d

# Production frontend URLs (comma-separated, no trailing slash)
CORS_ORIGIN=https://customer.example.com,https://kitchen.example.com,https://waiter.example.com,https://admin.example.com,https://cashier.example.com

# Allow Vercel preview URLs (*.vercel.app) in addition to CORS_ORIGIN — recommended for PR previews
CORS_ALLOW_VERCEL_PREVIEWS=1

# Used for Stripe checkout success/cancel and payment links (set to your Vercel customer URL)
CUSTOMER_APP_URL=https://customer.example.com
CASHIER_APP_URL=https://cashier.example.com

# Payments: none | mock | stripe
PAYMENT_PROVIDER=none

# --- Stripe (when PAYMENT_PROVIDER=stripe) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_TERMINAL=1
# STRIPE_TERMINAL_LOCATION_ID=tml_...

# --- Redis (recommended in production for Socket.IO / rate limits) ---
# Option A: Add a Railway Redis plugin and set REDIS_URL from it
# REDIS_URL=redis://default:PASS@redis.railway.internal:6379
# REDIS_SOCKET_ADAPTER=true
#
# Option B: Single replica only — allow in-memory fallback
# REDIS_OPTIONAL=1

# --- Local dev only (do not use in Railway) ---
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/restaurant_platform
