# Copy to Railway → Variables (or local backend/.env)
# Neon: use pooled URL for runtime; direct URL optional for migrate-only jobs.

NODE_ENV=production
PORT=3000

# Neon PostgreSQL (Settings → Connection string → Pooled)
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=replace-with-long-random-string
# HMAC secret for dine-in table presence cookies (defaults to JWT_SECRET).
# Required in production (with JWT_SECRET). Prefer a dedicated value.
# TABLE_PRESENCE_SECRET=replace-with-long-random-string
# Table order PINs are 6 digits; verify endpoint is rate-limited (5/min).
# Short-lived access JWT (memory-only on Admin/Cashier). Refresh cookie lasts JWT_REFRESH_EXPIRES_DAYS.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=14
# Force Secure + SameSite=None cookies (production default). Set 0 for local HTTP.
# COOKIE_SECURE=1
# Printed table + walk-in QR capability tokens (default 90 days). Rotate from Admin to revoke immediately.
QR_TOKEN_TTL_DAYS=90
# Scrape token for GET /api/metrics and GET /api/slo (required in production).
# Prometheus: authorization.credentials = this value (Bearer).
METRICS_TOKEN=replace-with-long-random-string

# Production frontend URLs (comma-separated, no trailing slash)
# Include app hosts + a wildcard for restaurant guest subdomains (Pattern B).
# Used by both HTTP CORS and Socket.IO (/realtime) — wildcards like https://*.maylesoft.com are supported.
CORS_ORIGIN=https://admin.maylesoft.com,https://kitchen.maylesoft.com,https://waiter.maylesoft.com,https://till.maylesoft.com,https://maylesoft.com,https://*.maylesoft.com

# Public API origin (no /api) — used for uploaded image absolute URLs
PUBLIC_API_ORIGIN=https://backend-production-7d4c.up.railway.app

# Allow Vercel preview URLs (*.vercel.app) in addition to CORS_ORIGIN — recommended for PR previews
CORS_ALLOW_VERCEL_PREVIEWS=1

# Used for Stripe checkout success/cancel and payment links (set to your Vercel customer URL)
CUSTOMER_APP_URL=https://customer.example.com
CASHIER_APP_URL=https://cashier.example.com

# Payments: none | mock | stripe
PAYMENT_PROVIDER=none

# --- Stripe (when PAYMENT_PROVIDER=stripe) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_TERMINAL=1
# STRIPE_TERMINAL_LOCATION_ID=tml_...

# --- Redis (required in production for Socket.IO + rate limits) ---
# Add a Railway Redis plugin and set REDIS_URL from it.
REDIS_URL=redis://default:PASS@redis.railway.internal:6379
# REDIS_SOCKET_ADAPTER=true
#
# Local/dev only: omit REDIS_URL to use in-memory fallbacks (single process).
# REDIS_OPTIONAL has been removed — production always requires Redis.

# --- Local dev only (do not use in Railway) ---
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/restaurant_platform
